# ==============================================================================
# AgroGuard FastAPI Backend Environment Variables Template
# ==============================================================================
HOST=0.0.0.0
PORT=5000
DEBUG=False
SECRET_KEY=REPLACE_WITH_A_UNIQUE_RANDOM_SECRET

# ==============================================================================
# Supabase Authentication & PostgreSQL Database Configuration
# ==============================================================================
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-secret-key-here
SUPABASE_ANON_KEY=your-supabase-anon-key-here
SUPABASE_JWT_SECRET=your-supabase-jwt-secret-here
SUPABASE_ENABLED=true
AUTH_ENABLED=true
